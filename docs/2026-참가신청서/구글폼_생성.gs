// ── 본체 ───────────────────────────────────────────────────────────────────
function createForm() {
  var form = FormApp.create(TITLE);
  form.setDescription(INTRO);
  form.setProgressBar(true);
  form.setAllowResponseEdits(true);       // 마감 전 재제출·수정 허용
  form.setConfirmationMessage(DONE);

  // 응답자 이메일 수집. API 이름이 바뀐 적이 있어 실패해도 넘어가게 둔다.
  try { form.setCollectEmail(true); } catch (e) { log_('이메일 수집은 폼 설정에서 직접 켜주세요'); }

  var email = FormApp.createTextValidation().requireTextIsEmail().build();

  // ── 1. 팀 정보 ───────────────────────────────────────────────────────────
  page_(form, '1. 팀 정보', '팀 이름과 아이템을 알려주세요.');

  ask_(form, '팀명', '개인으로 참가하시면 본인 이름을 적어주세요.', true);

  form.addMultipleChoiceItem()
    .setTitle('참가 형태')
    .setChoiceValues(['개인 (1인)', '2인 팀', '3인 팀', '4인 팀'])
    .setRequired(true);

  ask_(form, '아이템 한 줄 소개',
    '누구의 어떤 불편을 어떻게 푸는지 한 문장으로 적어주세요. 50자 내외.\n' +
    '예) 자취생이 냉장고에 남은 재료만으로 만들 수 있는 요리를 추천해 주는 앱', true);

  form.addParagraphTextItem()
    .setTitle('아이템 상세 설명')
    .setHelpText('200자 내외. 사업계획서에 충분히 담으셨다면 비워두셔도 됩니다.')
    .setRequired(false);

  // ── 2. 대표자 정보 ───────────────────────────────────────────────────────
  page_(form, '2. 대표자 정보', '대회 관련 안내를 받으실 분의 정보입니다.');

  ask_(form, '대표자 성명', '', true);
  ask_(form, '소속 대학', '예) 한국항공대학교', true);
  ask_(form, '학과 / 학년', '예) 소프트웨어학과 3학년 · 대학원 석사 1학기', true);
  ask_(form, '휴대전화번호', '예) 010-0000-0000', true);

  form.addTextItem()
    .setTitle('이메일')
    .setHelpText('접수 확인, 일정 변경, 예선 결과가 모두 이 주소로 발송됩니다. 정확히 적어주세요.')
    .setValidation(email)
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle('거주 지역')
    .setHelpText('본 대회는 고양시 및 경기북부 거주 대학(원)생을 대상으로 합니다.')
    .setChoiceValues([
      '고양시',
      '경기북부 (파주 · 김포 · 의정부 · 양주 · 동두천 · 포천 · 연천 · 남양주 · 구리 · 가평)',
      '그 외 지역',
    ])
    .setRequired(true);

  // ── 3. 팀원 정보 ─────────────────────────────────────────────────────────
  page_(form, '3. 팀원 정보',
    '개인으로 참가하시면 이 장은 그대로 넘기셔도 됩니다.\n' +
    '한 칸에 한 명씩, 아래 순서대로 한 줄로 적어주세요.\n' +
    '이름 / 소속 대학 / 학과·학년 / 연락처\n' +
    '예) 홍길동 / 한국항공대학교 / 경영학과 3학년 / 010-0000-0000');

  ask_(form, '팀원 2', '', false);
  ask_(form, '팀원 3', '', false);
  ask_(form, '팀원 4', '', false);

  // ── 4. 사업계획서 ────────────────────────────────────────────────────────
  page_(form, '4. 사업계획서 제출',
    '「AI 창업 아이템 사업계획서」 1부를 첨부해 주세요.\n' +
    'PDF · 한글(HWP) · 워드(DOCX) 중 택1, 20MB 이내, 양식은 자유입니다.\n\n' +
    '※ 평가 기준 (총 100점) : 문제 정의 능력 10 · AI를 통한 솔루션의 적합성 20 ·\n' +
    '   시장 규모 15 · 비즈니스 모델 타당성 20 · 아이템 구현에 대한 계획 20 · 사업 의지 15\n' +
    '※ 사업계획서만으로 평가하며 프로토타입은 받지 않습니다.\n' +
    '※ 마감(10. 9.(금) 18:00) 전까지 다시 제출하시면 마지막 제출본으로 평가합니다.\n' +
    '※ 첨부를 위해 Google 계정 로그인이 필요합니다. 업로드가 계속 안 되면\n' +
    '   ces@rebornmarket.org 로 메일 제출해 주셔도 접수됩니다.');

  form.addSectionHeaderItem()
    .setTitle('⬇⬇ [편집자 확인] 이 자리에 「파일 업로드」 문항을 직접 추가하고, 이 안내 블록은 삭제하세요 ⬇⬇')
    .setHelpText(
      '질문 제목 : 사업계획서 파일\n' +
      '질문 유형 : 파일 업로드\n' +
      '설명 : PDF · 한글(HWP) · 워드(DOCX) 중 택1 / 20MB 이내\n' +
      '특정 파일 형식 허용 : PDF, 문서\n' +
      '최대 파일 수 : 1   ·   최대 파일 크기 : 100MB\n' +
      '필수 질문 : 켜기\n\n' +
      '(파일 업로드 문항은 Apps Script 로 만들 수 없어 손으로 추가해야 합니다)');

  form.addParagraphTextItem()
    .setTitle('사업계획서 보충 설명')
    .setHelpText('데모 링크, 깃허브 주소, 참고 자료 등 함께 보시면 좋을 내용이 있으면 적어주세요.')
    .setRequired(false);

  // ── 5. 특강 · 멘토링 ─────────────────────────────────────────────────────
  page_(form, '5. 창업 특강 및 온라인 멘토링', '');

  form.addMultipleChoiceItem()
    .setTitle('창업 특강(9. 28.(월) 12:00~14:00) 참석 여부')
    .setHelpText('특강 참석은 선택이며, 참석하지 않으셔도 참가 자격에 영향이 없습니다.')
    .setChoiceValues(['참석했습니다', '참석할 예정입니다', '참석하지 못했습니다'])
    .setRequired(true);

  form.addCheckboxItem()
    .setTitle('온라인 팀별 멘토링 참여 가능 시간대')
    .setHelpText('10. 13.(화) ~ 10. 18.(일) · 서류 합격 팀 대상 · 팀당 1회\n' +
      '가능한 시간대를 모두 골라주세요. 팀별 일정은 서류 합격 안내 때 조율합니다.')
    .setChoiceValues(['평일 낮 (10시~18시)', '평일 저녁 (18시~21시)',
                      '주말 낮 (10시~18시)', '주말 저녁 (18시~21시)'])
    .setRequired(true);

  form.addParagraphTextItem()
    .setTitle('멘토링에서 가장 듣고 싶은 것')
    .setHelpText('멘토 배정에 참고합니다. 지금 가장 막혀 있는 부분을 적어주세요.')
    .setRequired(false);

  // ── 6. 동의 ──────────────────────────────────────────────────────────────
  page_(form, '6. 동의 및 확인', '');

  form.addCheckboxItem()
    .setTitle('개인정보 수집 · 이용 동의 (필수)')
    .setHelpText(PRIVACY)
    .setChoiceValues(['위 내용에 동의합니다'])
    .setRequired(true);

  form.addCheckboxItem()
    .setTitle('초상권 및 결과물 활용 동의 (필수)')
    .setHelpText('행사 중 촬영된 사진·영상과 제출 결과물이 사업 결과보고 및 홍보 목적으로 ' +
      '활용될 수 있습니다. 사업계획서의 영업비밀에 해당하는 내용은 공개하지 않습니다.')
    .setChoiceValues(['위 내용에 동의합니다'])
    .setRequired(true);

  form.addCheckboxItem()
    .setTitle('일정 변경 가능성 확인 (필수)')
    .setHelpText('대회 일정은 운영 사정에 따라 변경될 수 있으며, 변경 시 신청하신 이메일로 ' +
      '개별 안내된다는 점을 확인하였습니다.')
    .setChoiceValues(['확인하였습니다'])
    .setRequired(true);

  form.addParagraphTextItem()
    .setTitle('문의사항')
    .setHelpText('궁금한 점이 있으시면 자유롭게 적어주세요.')
    .setRequired(false);

  // ── 응답 시트 연결 ───────────────────────────────────────────────────────
  var sheetUrl = '(연결 실패 — 폼 [응답] 탭에서 직접 연결하세요)';
  try {
    var ss = SpreadsheetApp.create(TITLE + ' (응답)');
    form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());
    sheetUrl = ss.getUrl();
  } catch (e) { log_('응답 시트 연결 실패: ' + e.message); }

  log_('');
  log_('━━━━━━━━━━ 생성 완료 ━━━━━━━━━━');
  log_('편집 URL : ' + form.getEditUrl());
  log_('응답 URL : ' + form.getPublishedUrl());
  log_('응답 시트 : ' + sheetUrl);
  log_('');
  log_('남은 일 : 편집 URL 을 열어 4장의 「파일 업로드」 문항을 추가하고');
  log_('          그 자리의 [편집자 확인] 안내 블록을 삭제하세요.');
}

// ── 헬퍼 ───────────────────────────────────────────────────────────────────
function page_(form, title, help) {
  var p = form.addPageBreakItem().setTitle(title);
  if (help) p.setHelpText(help);
  return p;
}

function ask_(form, title, help, required) {
  var q = form.addTextItem().setTitle(title).setRequired(required);
  if (help) q.setHelpText(help);
  return q;
}

function log_(s) { Logger.log(s); }
